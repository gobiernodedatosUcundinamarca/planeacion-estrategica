# Copia este archivo como `.env` y ajusta los valores.
# El `.env` real no se versiona; este ejemplo sí, para documentar qué
# variables necesita el proyecto.

# PIN de acceso a la vista /admin. Solo servidor: sin él, nadie entra.
ADMIN_PIN=

# Postgres (Neon) donde se guardan las respuestas del Momento 4.
# Con pooler para la aplicación; sin pooler para migraciones y carga inicial.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Editor en producción: solo servidor. No usar NEXT_PUBLIC_ ni subir el .env real.
# Preparar el verificador y el secreto mediante pnpm editorial:preparar.
# Dejar vacío en local para conservar EDITORIAL_LOCAL_DIR del lanzador.
EDITORIAL_STORAGE=
EDITORIAL_SCHEMA=editorial
EDITORIAL_PASSWORD_SCRYPT=
EDITORIAL_SESSION_SECRET=
# Orígenes HTTPS completos, sin barra final ni comodines, separados por comas.
EDITORIAL_ALLOWED_ORIGINS=
