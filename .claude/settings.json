{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "permissions": {
    "ask": ["Edit(/.claude/**)", "Edit(**/CLAUDE.md)", "Edit(**/CLAUDE.local.md)"],
    "deny": [
      "Bash(npm *)", "Bash(npx *)", "Bash(yarn *)", "Bash(bun *)",
      "PowerShell(npm *)", "PowerShell(npx *)", "PowerShell(yarn *)", "PowerShell(bun *)",
      "Read(./.env)", "Read(./.env.local)", "Read(./pnpm-lock.yaml)", "Read(./.next/**)",
      "Read(./portal-build-portable/**)", "Read(./portal-portable/**)", "Read(./base-local/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-config.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
